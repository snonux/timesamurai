# timesamurai sectioned config example
#
# Location: $XDG_CONFIG_HOME/timesamurai/config.toml
# (usually ~/.config/timesamurai/config.toml)
#
# Copy this file into place and edit. Environment variables (TIMESAMURAI_*)
# always take precedence over the file. See docs/configuration.md.
#
# There is no per-project config layer (unlike hexai's .hexaiconfig.toml).

[storage]
# Where the JSONL store lives. Deployed value is a subdirectory of the worktime
# repo so it syncs with everything else. Defaults to db_dir when unset.
store_dir = "~/git/worktime/timesamuraidb"

# Where worktime.rb's db.*.json live: the migration source, and the target of
# the one-way export that keeps `worktime.rb --report` working.
db_dir = "~/git/worktime"

[accounting]
week_work_hours = 40
plus_for   = ["off", "bank", "bufferuse", "sick"]
minus_for  = ["lunch"]
buffer_for = ["tools", "pet", "selfdevelopment", "workrebalance",
              "compensate", "travel", "rebalance"]
weekend_days = ["Sat", "Sun"]

[general]
hostname = ""                  # override the detected hostname
auto_worktime_login = false
# File `work start` creates and `work stop` removes, so shell prompts can tell
# whether you are logged in. "" disables it.
login_marker = "~/.tsloggedin"

[report]
color = true                 # master switch for all terminal colors
verbose = false

# [colors] remaps which style each role uses; the defaults live in
# internal/ansi. Styles: black..white, brightblack..brightwhite, default,
# plus bold, faint, italic, underline (space-joined, e.g. "bold red").
# All colors turn off with report.color = false, the TIMESAMURAI_COLOR env
# var, the --no-color flag, or a NO_COLOR environment variable; output is
# also uncolored whenever the output stream is not a terminal.
# [colors]
# header    = "bold"
# separator = "faint"
# success   = "green"
# warn      = "yellow"
# error     = "red"
# address   = "cyan"
# time      = "blue"
# dim       = "faint"
# positive  = "green"
# negative  = "red"
# key       = "magenta"   # report categories, actions, --help commands/flags
# value     = "bold"      # durations and other figures
# tag       = "yellow"
